/* 页面整体容器 */
.container {
    background: #f7f7f7;
    min-height: 100vh;
    padding-bottom: 200rpx;
  }
  
  /* 导航栏 */
  .navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 95rpx;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .nav-left,
  .nav-right {
    width: 80rpx;
    text-align: center;
  }
  
  .nav-center {
    flex: 1;
    text-align: center;
  }
  
  .back-icon {
    width: 48rpx;
    height: 48rpx;
  }
  
  .nav-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  /* 滚动区域 */
  .scroll-area {
    position: absolute;
    top: 175rpx; /* 导航栏高度 */
    bottom: 120rpx; /* 购物车栏高度 */
    left: 0;
    right: 0;
    overflow: auto;
  }
  
  /* 菜品大图 */
  .dish-image {
    width: 100%;
    height: 700rpx;
    object-fit: cover;
    background-color: #eaeaea;
  }
  
  /* 白色卡片 */
  .detail-card {
    background: white;
    margin-top: 40rpx;
    margin-left: 20rpx;
    margin-right: 20rpx;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  }
  
  /* 标题价格部分 */
  .dish-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 20rpx;
  }
  
  .dish-price {
    font-size: 48rpx;
    color: #ff4757;
    font-weight: bold;
  }
  
  .dish-name {
    font-size: 34rpx;
    font-weight: bold;
    margin-top: 10rpx;
  }
  
  /* 月售 / 库存 + 数量控制器 */
  .dish-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .dish-meta {
    font-size: 26rpx;
    color: #666;
    display: flex;
    gap: 40rpx;
  }
  
  /* 数量控制器 */
  .controls-right {
    display: flex;
    align-items: center;
  }
  
  .quantity-control {
    display: flex;
    align-items: center;
    gap: 10rpx;
  }
  
  .quantity-btn {
    width: 40rpx;
    height: 40rpx;
    line-height: 36rpx;
    text-align: center;
    border-radius: 50%;
    font-size: 36rpx;
    font-weight: bold;
    transition: all 0.3s ease;
  }
  
  .quantity-btn.plus {
    background: #ff6b35;
    color: white;
    box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
  }
  
  .quantity-btn.minus {
    background: #f8f9fa;
    color: #666;
    border: 1rpx solid #e0e0e0;
  }
  
  .quantity-btn:active {
    transform: scale(0.92);
  }
  
  .quantity-text {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    min-width: 40rpx;
    margin-top: -40rpx;
    text-align: center;
  }
  
  /* 信息区域 */
  .info-section {
    margin-top: 20rpx;
  }
  
  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .info-label {
    font-size: 28rpx;
    color: #999;
  }
  
  .info-value {
    font-size: 28rpx;
    color: #333;
  }
  
  /* 购物车底部栏 */
  .cart-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
    z-index: 1500;
  }
  
  .cart-info {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .cart-icon-container {
    position: relative;
  }
  
  .cart-icon {
    width: 60rpx;
    height: 60rpx;
  }
  
  .total-quantity {
    position: absolute;
    top: -8rpx;
    right: -8rpx;
    background: #ff6b35;
    color: white;
    font-size: 20rpx;
    padding: 8rpx;
    border-radius: 50%;
    min-width: 24rpx;
    text-align: center;
  }
  
  .price-info {
    display: flex;
    flex-direction: column;
  }
  
  .price-row {
    display: flex;
    align-items: center;
  }
  
  .total-price {
    font-size: 36rpx;
    color: #ff4757;
    font-weight: bold;
  }
  
  .no-items {
    font-size: 28rpx;
    color: #999;
  }
  
  /* 去结算按钮 */
  .checkout-btn {
    width: 200rpx;
    background: #ff6b35;
    color: white;
    border: none;
    border-radius: 50rpx;
    padding: 24rpx 40rpx;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
    text-align: center;
  }
  
  .checkout-btn.disabled {
    background: #cccccc;
    color: #999;
    box-shadow: none;
  }
  
 /* >>>>>>>>>>>>>>>>> 购物车面板（从餐厅详情页复制） <<<<<<<<<<<<<<<<<< */

  /* 购物车面板样式 */
  .order-panel-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 120rpx; /* 底部空出购物车栏 */
    background: rgba(0, 0, 0, 0);
    z-index: 1000;
    visibility: hidden;
    transition: all 0.3s ease;
    pointer-events: none;
  }
  
  .order-panel-mask.active {
    background: rgba(0, 0, 0, 0.5);
    visibility: visible;
    pointer-events: auto;
  }
  
  .order-panel {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 120rpx;
    background: white;
    border-radius: 24rpx 24rpx 0 0;
    z-index: 2000;
    transition: all 0.3s ease;
    height: 60vh;
    max-height: 60vh;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
  }
  
  .order-panel.active {
    transform: translateY(0);
  }
  
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .panel-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .eat-type-row {
    display: flex;
    align-items: center;
  }
  
  .eat-select {
    display: flex;
    gap: 20rpx;
  }
  
  .eat-btn {
    padding: 10rpx 26rpx;
    border-radius: 30rpx;
    border: 1px solid #ccc;
    font-size: 26rpx;
    color: #666;
  }
  
  .eat-btn.active {
    background: #ff6b35;
    border-color: #ff6b35;
    color: #fff;
  }

  .clear-cart {
    padding: 12rpx 24rpx;
    background: #f8f9fa;
    border-radius: 20rpx;
  }
  
  .clear-text {
    font-size: 26rpx;
    color: #666;
  }
  
  .order-items-scroll {
    flex: 1;
    max-height: 600rpx;
  }
  
  .order-items-list {
    padding: 20rpx 30rpx;
  }
  
  .order-dish-card {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .order-dish-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .order-dish-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .order-dish-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
  }
  
  .order-dish-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
    margin-right: 20rpx;
  }
  
  .order-dish-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
    flex-shrink: 0;
  }
  
  .order-dish-controls {
    display: flex;
    justify-content: flex-end;
  }
  
  .item-total-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
    margin-right: auto;
  }
  
  .order-quantity-control {
    display: flex;
    align-items: center;
    gap: 16rpx;
    justify-content: flex-end;
  }
  
  .order-quantity-btn {
    width: 48rpx;
    height: 48rpx;
    line-height: 44rpx;
    text-align: center;
    border-radius: 50%;
    color: white;
    border: none;
    font-size: 32rpx;
    font-weight: bold;
    background: #ff6b35;
    box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
  }
  
  .order-quantity-btn.minus {
    background: #f8f9fa;
    color: #666;
    border: 1rpx solid #e0e0e0;
    box-shadow: none;
  }
  
  .order-quantity-btn.disabled {
    background: #cccccc;
    color: #999999;
    box-shadow: none;
  }
  
  .order-quantity-text {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    min-width: 40rpx;
    text-align: center;
  }
  
  /* 购物车订单汇总 */
  .order-summary {
    padding: 30rpx;
    border-top: 1rpx solid #f0f0f0;
  }
  
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .summary-row.total {
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
  }
  
  .summary-label {
    font-size: 28rpx;
    color: #666;
  }
  
  .summary-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  
  .summary-row.total .summary-label {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .summary-row.total .summary-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
  }
  
  /* 结算面板样式 */
  .checkout-panel-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0);
    z-index: 2500;
    visibility: hidden;
    pointer-events: none;
  }
  
  .checkout-panel-mask.active {
    background: rgba(0, 0, 0, 0.5);
    visibility: visible;
    pointer-events: auto;
  }
  
  .checkout-panel {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: white;
    border-radius: 24rpx 24rpx 0 0;
    z-index: 2600;
    transition: all 0.2s ease;
    height: 90vh;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    opacity: 0;
  }
  
  .checkout-panel.active {
    opacity: 1;
  }
  
  /* 结算面板头部 */
  .back-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 10vh;
    max-height: 10vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    z-index: 2700;
  }
  
  .back-icon1 {
    width: 36rpx;
    height: 36rpx;
  }
  
  .checkout-tips {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 30rpx;
    padding: 16rpx 24rpx;
    margin: 0 20rpx;
    margin-right: 20%;
  }
  
  .tips-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 12rpx;
  }
  
  .tips-text {
    font-size: 24rpx;
    color: #ffffff;
    font-weight: 500;
  }
  
  .checkout-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
    background: white;
    border-radius: 24rpx 24rpx 0 0;
    margin-top: 30rpx
  }
  
  .checkout-restaurant-info {
    display: flex;
    align-items: center;
    flex: 1;
  }
  
  .checkout-restaurant-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .checkout-restaurant-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
  }
  
  .checkout-restaurant-status {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 12rpx;
  }
  
  /* 结算内容区域 */
  .checkout-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .checkout-items-section {
    flex: 1;
    padding: 20rpx 30rpx;
  }
  
  .checkout-items-list {
    max-height: 700rpx;
    overflow-y: auto;
  }
  
  .checkout-dish-item {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .checkout-dish-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .checkout-dish-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .checkout-dish-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
  }
  
  .checkout-dish-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
    margin-right: 20rpx;
  }
  
  .checkout-dish-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
    flex-shrink: 0;
  }
  
  .checkout-dish-quantity {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8rpx;
  }
  
  .quantity-label {
    font-size: 26rpx;
    color: #666;
  }
  
  .quantity-value {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  /* 结算费用明细 */
  .checkout-summary {
    padding: 30rpx;
    border-top: 1rpx solid #f0f0f0;
    border-bottom: 1rpx solid #f0f0f0;
    background: #fafafa;
    margin-bottom: 20rpx;
  }
  
  .checkout-summary-title {
    margin-bottom: 20rpx;
  }
  
  .summary-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  .checkout-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .checkout-summary-row.total {
    padding-top: 16rpx;
    border-top: 1rpx solid #e0e0e0;
  }
  
  .checkout-summary-row.total .summary-label {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .checkout-summary-row.total .summary-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
  }
  /* 结算底部栏 */
  .checkout-footer {
    background: white;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  }
  
  .checkout-total-section {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .total-label {
    font-size: 28rpx;
    color: #666;
  }
  
  .total-price-large {
    font-size: 36rpx;
    font-weight: bold;
    color: #ff4757;
  }
  
  /* 提交订单按钮 */
  .submit-order-btn {
    background: #ff6b35;
    color: white;
    border: none;
    border-radius: 50rpx;
    padding: 24rpx 48rpx;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
  }
  