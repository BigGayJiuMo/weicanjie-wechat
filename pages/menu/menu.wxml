<view class="container">

<!-- 搜索框 -->
<view class="search-bar">
  <view class="search-input-box">
    <image class="search-icon" src="/images/search.png" bindtap="goSearchPage"></image>
    <input
    class="search-input"
    placeholder="输入商家名称"
    bindtap="goSearchPage"
    disabled="true"
    />
  </view>
</view>

<!-- 左右结构 -->
<view class="content">

  <!-- 左侧分类菜单 -->
  <scroll-view class="left-menu" scroll-y="true">
    <view
      wx:for="{{categoryList}}"
      wx:key="id"
      class="left-item {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 右侧餐厅列表 -->
  <scroll-view class="right-content" scroll-y="true">
    <view
      wx:for="{{restaurants}}"
      wx:key="id"
      class="restaurant-card"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >

      <image class="cover" src="{{item.logoUrl}}"></image>

      <view class="info">

        <!-- 标题 -->
        <text class="title">{{item.name}}</text>

        <!-- 评分 & 月售 -->
        <view class="rating-row">

          <!-- 评分 -->
          <view class="restaurant-rating" wx:if="{{item.avgRating !== null}}">
            <text class="rating-star">★</text>
            <text class="rating-score">{{item.avgRating}}</text>
          </view>

          <!-- 月售 -->
          <text class="rating-count">月售{{item.monthlySales || 0}}</text>
        </view>

        <!-- 打包费（替代配送时间） -->
        <text class="delivery">打包费 ¥{{item.packingFee || 0}}</text>
        
      </view>

    </view>

  </scroll-view>
</view>

</view>
