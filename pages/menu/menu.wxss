.container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #fff;
  }
  
  /* 搜索栏 */
  .search-bar {
    padding: 95rpx 20rpx 20rpx;
    background: linear-gradient(135deg, #ff6b35, #ff8e53);
  }
  
  .search-input-box {
    width: 65%;
    display: flex;
    align-items: center;
    background: #f5f5f5;
    padding: 16rpx 24rpx;
    border-radius: 50rpx;
  }
  
  .search-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 16rpx;
    opacity: 0.6;
  }
  
  .search-input {
    flex: 1;
  }
  
  /* 主体左右结构 */
  .content {
    flex: 1;
    display: flex;
  }
  
  /* 左侧分类栏 */
  .left-menu {
    width: 180rpx;
    background: #f5f5f5;
  }
  
  .left-item {
    display: flex;
    align-items: center;  
    justify-content: center; 
    padding: 30rpx;
    font-size: 28rpx;
    color: #333;
  }
  
  .left-item.active {
    background: #fff;
    color: #ff6b35;
    font-weight: bold;
  }
  
  /* 右侧餐厅列表 */
  .right-content {
    flex: 1;
    padding: 20rpx;
  }
  
  .restaurant-card {
    display: flex;
    padding: 20rpx 0;
    border-bottom: 1px solid #eee;
  }
  
  .cover {
    width: 160rpx;
    height: 160rpx;
    border-radius: 10rpx;
  }
  
  .info {
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
  }
  
  /* 标题行：名称 + 状态 */
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8rpx;
  }
  
  .title {
    font-size: 30rpx;
    font-weight: bold;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 16rpx;
  }
  
  /* 营业状态 */
  .restaurant-status {
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    font-weight: bold;
    flex-shrink: 0; /* 防止状态标签被压缩 */
  }
  
  .status-open {
    background: #e8f5e8;
    color: #07c160;
  }
  
  .status-closed {
    background: #fef0f0;
    color: #ff4757;
  }
  
  .status-break {
    background: #fff7e6;
    color: #ff8c00;
  }

  .rating-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
    gap: 16rpx;
  }
  
  .restaurant-rating {
    display: flex;
    align-items: center;
  }
  
  .rating-star {
    color: #ff6b35;
    font-size: 24rpx;
    margin-right: 8rpx;
  }
  
  .rating-score {
    font-size: 26rpx;
    color: #ff6b35;
    margin-right: 16rpx;
    font-weight: bold;
  }
  
  .rating-count {
    font-size: 24rpx;
    color: #666;
  }
  
  .delivery {
    color: #888;
    font-size: 24rpx;
  }
  .load-more, .no-more {
    text-align: center;
    padding: 30rpx 0;
    color: #999;
    font-size: 26rpx;
  }
  /* 空状态 */
  .empty-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
  }
  
  .empty-image {
    width: 200rpx;
    height: 200rpx;
    opacity: 0.5;
    margin-bottom: 40rpx;
  }
  
  .empty-text {
    color: #999;
    font-size: 28rpx;
  }
  
  /* 加载中 */
  .loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40rpx;
  }
  
  .loading-text {
    color: #999;
    font-size: 28rpx;
  }