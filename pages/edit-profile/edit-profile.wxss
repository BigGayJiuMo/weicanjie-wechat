/* pages/edit-profile/edit-profile.wxss */
.container {
    min-height: 100vh;
    padding: 40rpx;
    background: linear-gradient(135deg, #ff6b35 0%, #ff8e53 100%);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

/* 导航栏样式 */
.navbar {
    background: transparent;
    padding: 20rpx 0;
    margin-top: 45rpx;
    margin-bottom: 10rpx;
}

.navbar-content {
    display: flex;
    align-items: center;
}

.nav-left {
    display: flex;
    align-items: center;
}

.back-icon {
    width: 48rpx;
    height: 48rpx;
    margin-right: 20rpx;
}

.nav-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #fff;
}

.card {
    width: 100%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20rpx);
    border-radius: 24rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
    border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.card-header {
    display: flex;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.3);
}

.card-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #fff;
}

.item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.item:last-child {
    border-bottom: none;
}

.item-left {
    display: flex;
    align-items: center;
    min-width: 100rpx;
}

.item-label {
    font-size: 32rpx;
    color: #fff;
    font-weight: 500;
}

.item-right {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-end;
    margin-left: 270rpx;
}

/* 头像样式 */
.avatar-button {
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    border-radius: 50%;
    width: 80rpx;
    height: 80rpx;
}

.avatar-button::after {
    border: none;
}

.avatar-preview {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    border: 2rpx solid rgba(255, 255, 255, 0.5);
}

/* 昵称显示样式 */
.nickname-text {
    font-size: 32rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-right: 10rpx;
}

.arrow {
    width: 24rpx;
    height: 24rpx;
}

/* 手机号显示 */
.phone-text {
    font-size: 32rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-right: 10rpx;
}

/* 弹窗样式 */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
}

.modal-content {
    background-color: white;
    border-radius: 24rpx;
    width: 80%;
    max-width: 600rpx;
    overflow: hidden;
}

.modal-header {
    padding: 40rpx 30rpx 20rpx;
    text-align: center;
    font-size: 36rpx;
    font-weight: bold;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.word-count-section {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 10rpx;
    width: 100%;
}

.word-count {
    font-size: 26rpx;
    color: #999;
    margin-right: 10rpx;
}

.word-count.over-length {
    color: #ff4d4d;
    font-weight: bold;
}

.over-length-tip {
    font-size: 24rpx;
    color: #ff4d4d;
    font-weight: 500;
}

.modal-body {
    padding: 0 30rpx 30rpx;
}

.nickname-input {
    width: 100%;
    height: 90rpx;
    padding: 0 20rpx;
    background-color: #f5f5f5;
    border-radius: 12rpx;
    font-size: 32rpx;
}

/* 手机号修改弹窗样式 */
.input-item {
    margin-bottom: 30rpx;
}

.phone-input, .verify-code-input {
    width: 100%;
    height: 90rpx;
    padding: 0 20rpx;
    background-color: #f5f5f5;
    border-radius: 12rpx;
    font-size: 32rpx;
    box-sizing: border-box;
}

.verify-code-item {
    display: flex;
    align-items: center;
    position: relative;
}

.verify-code-input {
    flex: 1;
    min-width: 300rpx;
    margin-right: 20rpx;
}

.get-code-btn {
    background: #ff6b35;
    color: white;
    border: none;
    border-radius: 12rpx;
    padding: 0 24rpx;
    height: 70rpx;
    line-height: 70rpx;
    font-size: 24rpx;
    white-space: nowrap;
    min-width: 200rpx;
}

.get-code-btn.disabled {
    background: #ccc;
    color: #999;
}

.modal-footer {
    display: flex;
    border-top: 1rpx solid #eee;
}

.cancel-btn, .confirm-btn {
    flex: 1;
    padding: 28rpx 0;
    text-align: center;
    font-size: 32rpx;
    background-color: transparent;
    border: none;
    border-radius: 0;
}

.cancel-btn {
    color: #666;
    border-right: 1rpx solid #eee;
}

.confirm-btn {
    color: #ff6b35;
}

.confirm-btn.disabled {
    color: #ccc;
    background-color: #f5f5f5;
}

/* 提示框样式 */
.toast {
    position: fixed;
    top: 120rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    padding: 20rpx 40rpx;
    border-radius: 12rpx;
    color: white;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    z-index: 1000;
}

.toast-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 12rpx;
}