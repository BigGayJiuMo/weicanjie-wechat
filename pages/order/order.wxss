/* pages/order/order.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 导航栏样式 */
.navbar {
  background: white;
  padding: 20rpx 30rpx;
  padding-top: 95rpx; 
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left, .nav-right {
  width: 80rpx;
  text-align: center;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 修复页面滚动区域 */
.page-scroll {
  flex: 1;
  height: calc(100vh - 200rpx); /* 使用完整的视口高度 */
  overflow-y: auto;
  box-sizing: border-box;
  padding-bottom: 95rpx; /* 为底部操作栏留出足够空间 */
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  padding: 60rpx 40rpx;
  color: white;
  display: flex;
  align-items: center;
}

.status-icon {
  margin-right: 30rpx;
}

.status-icon image {
  width: 80rpx;
  height: 80rpx;
}

.status-text {
  font-size: 42rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 通用卡片样式 */
.delivery-card,
.restaurant-card,
.products-card,
.order-info-card,
.amount-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.product-count {
  font-size: 28rpx;
  color: #666;
}

/* 配送信息 */
.delivery-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.delivery-label {
  font-size: 28rpx;
  color: #666;
}

.delivery-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 餐厅信息 */
.restaurant-info {
  display: flex;
  align-items: center;
}

.restaurant-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
}

.restaurant-details {
  flex: 1;
}

.restaurant-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.restaurant-address,
.restaurant-phone {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
}

/* 商品列表 */
.products-list {
  margin-top: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 500;
}

.product-quantity {
  margin-left: 20rpx;
}

.quantity {
  font-size: 28rpx;
  color: #666;
}

/* 订单信息 */
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-label {
  font-size: 28rpx;
  color: #666;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 金额明细 */
.amount-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 40rpx; /* 为底部操作栏留出额外空间 */
}

.amount-details {
  margin-top: 20rpx;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.amount-item.total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
}

.amount-value {
  font-size: 28rpx;
  color: #333;
}

.total-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

/* 加载状态 */
.loading-container {
  text-align: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 空状态 */
.empty-container {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.retry-btn {
  background-color: #ff6b35;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* 底部操作栏 */
.action-bar {
  background-color: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000; /* 确保在内容上方 */
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.action-btn {
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #ff6b35;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background-color: #ff6b35;
  color: white;
}

.action-btn.secondary {
  background-color: white;
  color: #ff6b35;
}

.action-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}