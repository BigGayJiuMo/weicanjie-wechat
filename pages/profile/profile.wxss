/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  padding: 60rpx 40rpx 40rpx;
  padding-top: 90rpx;
  color: white;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 30rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-phone {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  letter-spacing: 2rpx; /* 增加字母间距，让脱敏手机号更易读 */
}

/* 用户统计 */
.user-stats {
  display: flex;
  justify-content: space-around;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  padding-top: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 菜单区域 */
.menu-section {
  background: white;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-badge {
  background: #ff6b35;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
}

.service-tip {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.menu-arrow {
  width: 24rpx;
  height: 24rpx;
}

/* 操作按钮区域 */
.action-section {
  padding: 0 30rpx;
}

.login-btn, .logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 50rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.login-btn {
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  color: white;
}

.logout-btn {
  background: #f0f0f0;
  color: #666;
}

/* 客服弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  padding: 40rpx;
}

.modal-container {
  background: white;
  border-radius: 20rpx;
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-content {
  padding: 60rpx 40rpx;
  text-align: center;
}

.service-phone {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx; /* 增加客服电话的字母间距 */
}

.service-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.modal-buttons {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.cancel-btn {
  background: #f0f0f0;
  color: #666;
}

.confirm-btn {
  background: #ff6b35;
  color: white;
}