.container {
  background: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部导航 */
.navbar {
  background: white;
  padding: 20rpx 30rpx;
  padding-top: 95rpx; 
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left, .nav-right {
  width: 80rpx;
  text-align: center;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}


.content-scroll {
  flex: 1;
  height: calc(100vh - 200rpx);
}

/* 空状态 */
.empty-box {
    margin-top: 120rpx;
    text-align: center;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}

/* 历史卡片（使用收藏样式） */
.favorite-item {
    background: white;
    border-radius: 20rpx;
    margin: 24rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

/* 餐厅卡片布局 */
.restaurant-item {
  background: white;
  border-radius: 20rpx;
}

.restaurant-body {
  display: flex;
  padding: 30rpx;
}

.restaurant-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.restaurant-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.restaurant-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.restaurant-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.restaurant-rating {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rating-star {
  font-size: 24rpx;
  color: #ff6b35;
}

.rating-score {
  font-size: 28rpx;
  color: #ff6b35;
  margin: 0 12rpx;
}

.rating-count {
  font-size: 24rpx;
  color: #666;
}

.restaurant-info {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
}

/* 浏览时间 */
.browse-time-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
