<view class="container">

<!-- 顶部导航栏 -->
<view class="navbar">
  <view class="navbar-content">
    <view class="nav-left">
      <image src="/images/back.png" class="back-icon" bindtap="onBack"></image>
    </view>
    <view class="nav-center">
      <text class="nav-title">我的收藏</text>
    </view>
    <view class="nav-right"></view>
  </view>
</view>

<scroll-view class="content-scroll" scroll-y="true">

  <!-- 收藏列表 -->
        <view wx:if="{{favorites.length > 0}}" class="list-box">

        <view wx:for="{{favorites}}" wx:key="id" class="favorite-item">

        <view class="restaurant-item" bindtap="goDetail" data-id="{{item.id}}">

            <view class="restaurant-body">

            <image 
                class="restaurant-image" 
                src="{{item.logoUrl || '/images/default-restaurant.png'}}"
                mode="aspectFill"
            />

            <view class="restaurant-content">

                <!-- 名称 + 取消收藏按钮 -->
                <view class="restaurant-header">
                <text class="restaurant-name">{{item.name}}</text>

                <image 
                    class="fav-icon"
                    src="/images/fav-on.png"
                    catchtap="onCancelFavorite"
                    data-id="{{item.id}}"
                />
                </view>

                <!-- 评分 + 月售 -->
                <view class="restaurant-rating">
                    <text class="rating-star">★</text>
                    <text class="rating-score">{{item.avgRating || 5.0}}</text>
                    <text class="rating-count">月售{{item.monthlySales || 0}}</text>
                </view>

                <!-- 餐厅描述（删除起送、配送） -->
                <view class="restaurant-desc">
                    <text class="desc-text">{{item.description}}</text>
                </view>

            </view>

            </view>

        </view>

        </view>

        </view>

  <!-- 空状态 -->
  <view wx:if="{{favorites.length === 0}}" class="empty-box">
    <text class="empty-text">没有更多了</text>
  </view>

</scroll-view>
</view>
