.container {
    background: #f5f5f5;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

/* 顶部导航栏 */
.navbar {
  background: white;
  padding: 20rpx 30rpx;
  padding-top: 95rpx; 
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left, .nav-right {
  width: 80rpx;
  text-align: center;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 内容滚动区域 */
.content-scroll {
  flex: 1;
  height: calc(100vh - 200rpx);
}

/* 左滑结构 */
.favorite-item-wrapper {
    width: 100%;
    height: 260rpx;
    position: relative;
    overflow: hidden;
}

/* movable-area 必须有尺寸 */
.movable-area {
    width: 100%;
    height: 260rpx;
    position: relative;
  }
  
  /* movable-view 也必须同样大小 */
  .movable-view {
    height: 260rpx;
  background: white;
  position: absolute;
  left: 0;
  top: 0;
  width: calc(100% + 160rpx);
  }
  
  /* 删除按钮 */
  .delete-btn {
    position: absolute;
    right: 0;
    top: 0;
    width: 160rpx;
    height: 260rpx;
    background: #ff4d4f;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28rpx;
    font-weight: bold;
  }

/* 餐厅卡片（复用首页样式） */
.restaurant-item {
    height: 260rpx;
    display: flex;
    padding: 30rpx;
    box-sizing: border-box;
  }
  
  .restaurant-image {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    margin-right: 24rpx;
    object-fit: cover;
  }
  
  .restaurant-content { flex: 1; }
  
  .restaurant-name {
    font-size: 32rpx;
    font-weight: bold;
  }
  
  .restaurant-rating {
    margin-top: 10rpx;
    display: flex;
    align-items: center;
  }
  
  .rating-star {
    color: #ff6b35;
  }

.rating-score {
  margin-left: 6rpx;
  margin-right: 14rpx;
  color: #ff6b35;
}

.restaurant-info {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  display: flex;
  gap: 20rpx;
}

/* 空状态 */
.empty-box {
  margin-top: 120rpx;
  text-align: center;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}
