/* pages/payment/payment.wxss */
.container {
    padding: 0;
    background: #f5f5f5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    height: 100vh; /* 添加固定高度 */
}

/* 导航栏样式 */
.navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 95rpx;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1rpx solid #f0f0f0;
    flex-shrink: 0;
}

.navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-left, .nav-right {
    width: 80rpx;
    text-align: center;
}

.nav-center {
    flex: 1;
    text-align: center;
}

.back-icon {
    width: 48rpx;
    height: 48rpx;
}

.nav-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

/* 页面滚动区域 - 修复高度问题 */
.page-scroll {
    flex: 1;
    height: calc(100vh - 200rpx); /* 计算可用高度 */
    padding-bottom: 120rpx;
    box-sizing: border-box; /* 确保padding包含在高度内 */
    overflow-y: auto; /* 确保可以滚动 */
}

/* 卡片样式 */
.order-info-card,
.products-card,
.amount-card,
.payment-method-card {
    background: white;
    border-radius: 20rpx;
    margin: 20rpx; /* 修改为上下边距 */
    padding: 30rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.card-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

/* 订单信息 */
.order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.order-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

.order-status {
    height: 70rpx;
    line-height: 25rpx;
    font-size: 24rpx;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-weight: bold;
}

.order-status.pending {
    background: #fff0e8;
    color: #ff6b35;
}

.order-status.paid {
    background: #e8f5e8;
    color: #07c160;
}

.detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.detail-item:last-child {
    margin-bottom: 0;
}

.detail-label {
    font-size: 28rpx;
    color: #666;
}

.detail-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

/* 商品列表 */
.products-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.product-item {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
    border-bottom: none;
}

.product-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.product-name {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 8rpx;
}

.product-price {
    font-size: 26rpx;
    color: #ff4757;
    font-weight: bold;
}

.product-quantity {
    margin-left: auto;
}

.quantity {
    font-size: 28rpx;
    color: #666;
}

/* 金额明细 */
.amount-details {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.amount-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.amount-item.total {
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
}

.amount-label {
    font-size: 28rpx;
    color: #666;
}

.amount-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.total-amount {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
}

/* 支付方式 */
.payment-method {
    display: flex;
    flex-direction: column;
}

.method-item {
    display: flex;
    align-items: center;
    padding: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.method-item:last-child {
    border-bottom: none;
}

.method-item.active {
    background: #f8f9fa;
}

.method-icon {
    width: 48rpx;
    height: 48rpx;
    margin-right: 20rpx;
}

.method-name {
    flex: 1;
    font-size: 28rpx;
    color: #333;
}

.method-check {
    width: 32rpx;
    height: 32rpx;
}

/* 底部支付栏 */
.payment-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
    z-index: 1000;
}

.payment-info {
    flex: 1;
}

.payment-label {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 4rpx;
}

.payment-amount {
    font-size: 36rpx;
    font-weight: bold;
    color: #ff4757;
}

.payment-buttons {
    display: flex;
    gap: 20rpx;
}

.cancel-btn, .pay-btn {
    padding: 20rpx 40rpx;
    border-radius: 50rpx;
    font-size: 28rpx;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    user-select: none;
    transition: all 0.3s ease;
}

.cancel-btn {
    background: #f0f0f0;
    color: #666;
}

.cancel-btn:active {
    background: #e0e0e0;
}

.pay-btn {
    background: #ff6b35;
    color: white;
    box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.pay-btn:active {
    transform: scale(0.98);
    box-shadow: 0 2rpx 6rpx rgba(255, 107, 53, 0.3);
}
/* 禁用状态的支付按钮样式 */
.pay-btn.disabled {
    background: #cccccc !important;
    box-shadow: none !important;
    cursor: not-allowed !important;
}

.pay-btn.disabled:active {
    transform: none !important;
    box-shadow: none !important;
}
/* 弹窗样式 */
.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    padding: 40rpx;
}

.modal-container {
    padding: 0 20rpx 20rpx 20rpx;
    background: white;
    border-radius: 20rpx;
    width: 100%;
    max-width: 600rpx;
    overflow: hidden;
}

.success-modal {
    text-align: center;
    padding: 40rpx;
}

.modal-icon {
    margin-bottom: 20rpx;
}

.modal-icon image {
    width: 80rpx;
    height: 80rpx;
}

.modal-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
}

.modal-content {
    margin-bottom: 30rpx;
}

.modal-content text {
    display: block;
    font-size: 26rpx;
    color: #666;
    margin-bottom: 8rpx;
}

.modal-buttons {
    display: flex;
    gap: 20rpx;
}

.modal-btn {
    flex: 1;
    padding: 20rpx;
    border-radius: 12rpx;
    font-size: 28rpx;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
}

.modal-btn.primary {
    background: #ff6b35;
    color: white;
}

.modal-btn.primary:active {
    background: #e55a2b;
}

.modal-btn.secondary {
    background: #f0f0f0;
    color: #666;
}

.modal-btn.secondary:active {
    background: #e0e0e0;
}

.modal-btn.cancel {
    background: #f0f0f0;
    color: #666;
}

.modal-btn.cancel:active {
    background: #e0e0e0;
}

.modal-btn.confirm {
    background: #ff6b35;
    color: white;
}

.modal-btn.confirm:active {
    background: #e55a2b;
}

.modal-header {
    padding: 40rpx 30rpx 20rpx;
    text-align: center;
}

.modal-header .modal-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin: 0;
}

/* 确保内容足够长时可以滚动 */
.page-content {
    min-height: 800rpx; /* 确保有足够的内容高度 */
}