<!-- pages/payment/payment.wxml -->
<view class="container">
    <!-- 顶部导航栏 -->
    <view class="navbar">
        <view class="navbar-content">
            <view class="nav-left">
                <image class="back-icon" src="/images/back.png" bindtap="onBack"></image>
            </view>
            <view class="nav-center">
                <text class="nav-title">订单支付</text>
            </view>
            <view class="nav-right"></view>
        </view>
    </view>

    <scroll-view class="page-scroll" scroll-y="true">
        <!-- 订单信息 -->
        <view class="order-info-card">
            <view class="order-header">
                <text class="order-title">订单信息</text>
                <text class="order-status {{order.status === 1 ? 'pending' : 'paid'}}">
                    {{order.status === 1 ? '待支付' : (order.status === 2 ? '待处理' : '已完成')}}
                </text>
            </view>
            
            <view class="order-details">
                <view class="detail-item">
                    <text class="detail-label">订单号</text>
                    <text class="detail-value">{{order.orderNumber}}</text>
                </view>
                <view class="detail-item">
                    <text class="detail-label">下单时间</text>
                    <text class="detail-value">{{formatTime(order.createdTime)}}</text>
                </view>
                <view class="detail-item">
                    <text class="detail-label">餐厅名称</text>
                    <text class="detail-value">{{restaurant.name}}</text>
                </view>
            </view>
        </view>

        <!-- 商品列表 -->
        <view class="products-card">
            <view class="card-header">
                <text class="card-title">商品清单</text>
            </view>
            <view class="products-list">
                <view class="product-item" wx:for="{{orderItems}}" wx:key="id">
                    <image class="product-image" src="{{item.dishImageUrl || '/images/default-dish.png'}}"></image>
                    <view class="product-info">
                        <text class="product-name">{{item.dishName}}</text>
                        <text class="product-price">¥{{item.dishPrice}}</text>
                    </view>
                    <view class="product-quantity">
                        <text class="quantity">×{{item.quantity}}</text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 金额明细 -->
        <view class="amount-card">
            <view class="card-header">
                <text class="card-title">金额明细</text>
            </view>
            <view class="amount-details">
                <view class="amount-item">
                    <text class="amount-label">商品金额</text>
                    <text class="amount-value">¥{{subTotal}}</text>
                </view>
                <view class="amount-item">
                    <text class="amount-label">配送费</text>
                    <text class="amount-value">¥{{deliveryFee}}</text>
                </view>
                <view class="amount-item total">
                    <text class="amount-label">实付金额</text>
                    <text class="amount-value total-amount">¥{{totalAmount}}</text>
                </view>
            </view>
        </view>

        <!-- 支付方式 -->
        <view class="payment-method-card">
            <view class="card-header">
                <text class="card-title">支付方式</text>
            </view>
            <view class="payment-method">
                <view class="method-item active">
                    <image class="method-icon" src="/images/wechat-pay.png"></image>
                    <text class="method-name">微信支付</text>
                    <image class="method-check" src="/images/checked.png"></image>
                </view>
            </view>
        </view>
    </scroll-view>

    <!-- 底部支付栏 -->
    <view class="payment-bar">
        <view class="payment-info">
            <text class="payment-label">需支付</text>
            <text class="payment-amount">¥{{totalAmount}}</text>
        </view>
        <view class="payment-buttons">
            <view class="cancel-btn" bindtap="onCancelPayment">取消支付</view>
            <view class="pay-btn" bindtap="onConfirmPayment">立即支付</view>
        </view>
    </view>

    <!-- 支付成功弹窗 -->
    <view wx:if="{{showSuccessModal}}" class="modal-mask" catchtap="hideSuccessModal">
        <view class="modal-container success-modal" catchtap="stopPropagation">
            <view class="modal-icon">
                <image src="/images/success.png"></image>
            </view>
            <view class="modal-title">支付成功</view>
            <view class="modal-content">
                <text>订单号：{{order.orderNumber}}</text>
                <text>支付金额：¥{{totalAmount}}</text>
                <!-- 使用预先生成的支付时间 -->
                <text>支付时间：{{paymentTime}}</text>
            </view>
            <view class="modal-buttons">
                <view class="modal-btn primary" bindtap="onViewOrder">查看订单</view>
                <view class="modal-btn secondary" bindtap="onBackToHome">返回首页</view>
            </view>
        </view>
    </view>

    <!-- 取消支付确认弹窗 -->
    <view wx:if="{{showCancelModal}}" class="modal-mask" catchtap="hideCancelModal">
        <view class="modal-container" catchtap="stopPropagation">
            <view class="modal-header">
                <text class="modal-title">确认取消支付</text>
            </view>
            <view class="modal-content">
                <text>确定要取消此订单的支付吗？</text>
            </view>
            <view class="modal-buttons">
                <view class="modal-btn cancel" bindtap="hideCancelModal">继续支付</view>
                <view class="modal-btn confirm" bindtap="confirmCancelPayment">确认取消</view>
            </view>
        </view>
    </view>
</view>