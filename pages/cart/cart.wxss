/* pages/cart/cart.wxss */
.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 导航栏样式 */
.navbar {
  background: white;
  padding: 20rpx 30rpx;
  padding-top: 105rpx; 
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  flex-shrink: 0;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left, .nav-right {
  width: 80rpx;
  text-align: center;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: rgb(255, 255, 255);
}

/* 购物车内容区域 */
.cart-scroll {
  flex: 1;
  height: calc(100vh - 300rpx);
}

/* 餐厅购物车区域 */
.restaurant-cart-section {
  background: white;
  border-radius: 16rpx;
  margin: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 餐厅头部 */
.restaurant-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.restaurant-selector {
  margin-right: 20rpx;
}

.restaurant-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.delete-restaurant {
  padding: 10rpx;
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 购物车商品项 */
.cart-items {
  padding: 0 30rpx;
}

.cart-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f8f9fa;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-selector {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
}

/* 复选框样式 */
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.checkbox.checked {
  border-color: #ff6b35;
  background: #ff6b35;
}

.checkbox-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
  transition: all 0.3s ease;
}

.checkbox-inner.checked {
  background: white;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.item-price {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.item-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  color: white;
  border: none;
  font-size: 32rpx;
  font-weight: bold;
  background: #ff6b35;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
}

.quantity-btn.minus {
  background: #f8f9fa;
  color: #666;
  border: 1rpx solid #e0e0e0;
  box-shadow: none;
}

.quantity-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

.item-total-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff4757;
}

/* 空购物车状态 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
  padding: 100rpx 0;
  flex: 1;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.browse-btn {
  background: #ff6b35;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.browse-text {
  color: white;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.checkout-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.all-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.all-select-text {
  font-size: 28rpx;
  color: #333;
}

.checkout-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.total-price-section {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4757;
}

.checkout-btn {
  background: #ff6b35;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
  transition: all 0.3s ease;
  text-align: center;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
    tap-highlight-color: transparent;
    transition: all 0.2s ease;
}
.checkout-btn:active {
    transform: scale(0.97);
    opacity: 0.9;
}
.checkout-btn.disabled {
  background: #cccccc;
  color: #999999;
  box-shadow: none;
}

.checkout-btn.disabled:active {
  transform: none;
  box-shadow: none;
}