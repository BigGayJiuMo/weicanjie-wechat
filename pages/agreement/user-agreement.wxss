/* pages/agreement/user-agreement.wxss */
/* 导航栏样式 */
.navbar {
  background: white;
  padding: 20rpx 30rpx;
  padding-top: 95rpx;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left {
  width: 80rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: rgb(0, 0, 0);
  text-align: center;
}

.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.placeholder {
  width: 48rpx; 
  height: 48rpx;
}

.content{
  margin-top: 160rpx; 
  padding: 40rpx;
  min-height: 100vh;
  background: white;
  display: block; 
}

.title{
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333; 
  margin-bottom: 30rpx;
  text-align: center;
}

.section{
  display: block;
  font-size: 28rpx;
  color: #666; 
  line-height: 1.6;
}