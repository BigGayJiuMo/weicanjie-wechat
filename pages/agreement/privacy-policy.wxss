/* 通用样式 */
.container {
    height: 100vh;
    background-color: #ffffff;
  }
  
  .navbar {
    background-color: #ffffff;
    padding: 20rpx 30rpx;
    padding-top: 80rpx;
    border-bottom: 1rpx solid #f0f0f0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
  }
  
  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80rpx;
  }
  
  .nav-left {
    width: 80rpx;
  }
  
  .back-icon {
    width: 48rpx;
    height: 48rpx;
  }
  
  .nav-center {
    flex: 1;
    text-align: center;
  }
  
  .nav-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333333;
  }
  
  .nav-right {
    width: 80rpx;
  }
  
  .content-scroll {
    height: calc(100vh - 140rpx);
    padding-top: 140rpx;
    box-sizing: border-box;
  }
  
  /* 协议内容样式 */
  .agreement-content,
  .privacy-content {
    padding: 40rpx 30rpx 60rpx;
  }
  
  .title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #333333;
    text-align: center;
    margin-bottom: 20rpx;
  }
  
  .update-date {
    display: block;
    font-size: 24rpx;
    color: #999999;
    text-align: center;
    margin-bottom: 40rpx;
  }
  
  .section {
    margin-bottom: 40rpx;
  }
  
  .section-title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #333333;
    margin-bottom: 20rpx;
    line-height: 1.5;
  }
  
  .section-text {
    display: block;
    font-size: 28rpx;
    color: #666666;
    line-height: 1.8;
    text-align: justify;
  }
  
  .footer-tips {
    margin-top: 50rpx;
    padding: 30rpx;
    background-color: #f8f9fa;
    border-radius: 12rpx;
  }
  
  .footer-tips text {
    display: block;
    font-size: 26rpx;
    color: #666666;
    line-height: 1.6;
    text-align: justify;
  }