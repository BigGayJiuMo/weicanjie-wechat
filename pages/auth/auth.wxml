<!--pages/auth/auth.wxml-->
<view class="auth-container">
  <view class="auth-card">
    <image class="auth-logo" src="/images/logo.png"></image>
    <text class="auth-title">微餐捷点餐</text>
    <text class="auth-desc">请授权用户信息，享受便捷点餐服务</text>
    
    <!-- 用户信息授权按钮 -->
    <button class="auth-btn" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo">
      微信一键登录
    </button>
    
    <!-- 游客模式按钮 -->
    <button class="auth-btn guest-btn" bindtap="onGuestMode">
      游客模式进入
    </button>
    
    <text class="auth-tip">授权后即可开始点餐</text>
  </view>
</view>

<!-- 手机号授权弹窗 -->
<view wx:if="{{showPhoneModal}}" class="modal-mask">
  <view class="modal-container">
    <view class="modal-header">
      <text class="modal-title">申请获取并验证你的手机号</text>
      <text class="modal-subtitle">用于登录、注册小程序</text>
    </view>
    
    <view class="phone-display">
      <text class="phone-number">{{displayPhoneNumber}}</text>
      <text class="phone-tip-text">以上号码为模拟生成的手机号</text>
    </view>
    
    <view class="modal-buttons">
      <button class="modal-btn cancel-btn" bindtap="onCancelPhoneAuth">
        不允许
      </button>
      <button class="modal-btn confirm-btn" bindtap="onConfirmPhoneAuth">
        允许
      </button>
    </view>
    
    <view class="modal-footer">
      <text class="footer-text">授权后，我们将使用该手机号为您提供服务</text>
    </view>
  </view>
</view>