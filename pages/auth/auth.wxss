/* 导航栏样式 */
.navbar {
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  padding: 20rpx 30rpx;
  padding-top: 85rpx;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left, .nav-right {
  width: 80rpx;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.auth-container {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  padding: 40rpx;
  padding-top: 0rpx; /* 为导航栏留出空间 */
  box-sizing: border-box;
}

.auth-card {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
  width: 100%;
  position: relative;
  margin-top: 60rpx; /* 调整卡片位置 */
}

.auth-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.auth-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
  line-height: 1.5;
}

/* 手机号一键登录容器 */
.auth-btn-container {
  position: relative;
  width: 100%;
  margin-bottom: 30rpx;
}

.auth-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  text-align: center;
}

/* 透明按钮覆盖在view上面 */
.auth-btn-transparent {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  opacity: 0;
}

.auth-btn-transparent::after {
  border: none;
}

/* 其他手机号登录按钮 */
.other-phone-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #07c160;
  border-radius: 50rpx;
  color: #07c160;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  background: white;
  text-align: center;
}

/* 游客模式链接 */
.guest-link {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 用户协议勾选 - 居中显示 */
.agreement-section {
  margin-top: 40rpx;
  padding: 0 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.checkbox-container {
  display: flex;
  align-items: center;
  text-align: center;
  justify-content: center;
  max-width: 100%;
  flex-wrap: nowrap;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  margin-right: 16rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #07c160;
  border-color: #07c160;
}

.checkmark {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  white-space: nowrap;
  text-align: center;
}

.agreement-link {
  color: #07c160;
  white-space: nowrap;
}

/* 使用其他号码链接区域 */
.other-phone-link-section {
  padding: 0 40rpx 30rpx;
  text-align: center;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
  padding-top: 30rpx;
}

.other-phone-link {
  color: #07c160;
  font-size: 28rpx;
  text-decoration: underline;
}

/* 其他手机号登录弹窗样式 */
.other-phone-modal {
  max-width: 650rpx;
}

.modal-body {
  padding: 40rpx;
}

.input-item {
  margin-bottom: 40rpx;
}

.phone-input, .verify-code-input {
  width: 100%;
  height: 90rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  min-width: 00rpx;
}

.phone-input:focus, .verify-code-input:focus {
  border-color: #07c160;
  background-color: #fff;
}

.verify-code-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.verify-code-input {
  flex: 1;
  min-width: 300rpx;
}

.get-code-btn {
  background: #07c160;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 24rpx;
  white-space: nowrap;
  min-width: 200rpx;
}

.get-code-btn.disabled {
  background: #ccc;
  color: #999;
}

/* 弹窗样式保持不变 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  padding: 40rpx;
}

.modal-container {
  background: white;
  border-radius: 20rpx;
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.modal-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.phone-display {
  padding: 60rpx 40rpx;
  text-align: center;
  background: #f8f8f8;
  margin: 20rpx;
  border-radius: 12rpx;
}

.phone-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.phone-tip-text {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.modal-buttons {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn.disabled {
  background: #ccc;
  color: #999;
}

.cancel-btn {
  background: #f0f0f0;
  color: #666;
}

.cancel-btn:active {
  background: #e0e0e0;
}

.confirm-btn {
  background: #07c160;
  color: white;
}

.confirm-btn:active {
  background: #06ae56;
}

.modal-footer {
  padding: 0 40rpx 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}