/* pages/auth/auth.wxss */
.auth-container {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  padding: 40rpx;
}

.auth-card {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
  width: 100%;
}

.auth-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.auth-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
  line-height: 1.5;
}

.auth-btn {
  background: #07c160;
  color: white;
  border-radius: 50rpx;
  margin-bottom: 30rpx;
}

.auth-tip {
  font-size: 24rpx;
  color: #999;
}