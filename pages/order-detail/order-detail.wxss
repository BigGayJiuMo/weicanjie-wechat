/* pages/order-detail/order-detail.wxml.wxss */
.container {
    padding: 0;
    background: #f5f5f5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    height: 100vh; /* 添加固定高度 */
}

/* 导航栏样式 */
.navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 95rpx;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1rpx solid #f0f0f0;
    flex-shrink: 0;
}

.navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-left, .nav-right {
    width: 80rpx;
    text-align: center;
}

.nav-center {
    flex: 1;
    text-align: center;
}

.back-icon {
    width: 48rpx;
    height: 48rpx;
}

.nav-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

/* 页面滚动区域 - 修复高度问题 */
.page-scroll {
    flex: 1;
    height: calc(100vh - 200rpx); /* 计算可用高度 */
    padding-bottom: 120rpx;
    box-sizing: border-box; /* 确保padding包含在高度内 */
    overflow-y: auto; /* 确保可以滚动 */
}

/* 状态卡片 */
.status-card {
    background: linear-gradient(135deg, #ff6b35, #ff8e53);
    padding: 60rpx 40rpx;
    color: white;
    display: flex;
    align-items: center;
  }
  
  .status-icon {
    margin-right: 30rpx;
  }
  
  .status-icon image {
    width: 80rpx;
    height: 80rpx;
  }
  
  .status-text {
    font-size: 42rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 10rpx;
  }
  
  .status-desc {
    font-size: 28rpx;
    opacity: 0.9;
  }

/* 订单状态卡片 */
.status-card {
    background: linear-gradient(135deg, #ff6b35, #ff8e53);
    padding: 60rpx 40rpx;
    color: white;
    display: flex;
    align-items: center;
}

/* 订单卡片：合并餐厅信息、订单商品、订单信息、金额明细 */
.order-card {
    background: white;
    border-radius: 20rpx;
    margin: 20rpx;
    padding: 30rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 餐厅信息 */
.restaurant-info {
    display: flex;
    align-items: center;
    padding: 20rpx;
}

.restaurant-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.arrow-icon {
    margin-left: 10rpx;
    width: 24rpx;
    height: 24rpx;
}

/* 商品信息 */
.products-info {
    margin-top: 20rpx;
}

.products-list {
    margin-top: 20rpx;
}

.product-item {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f5f5f5;
}

.product-image {
    width: 100rpx;
    height: 100rpx;
    border-radius: 12rpx;
    margin-right: 30rpx;
}

.product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.product-name {
    font-size: 30rpx;
    color: #333;
}

.product-quantity {
    font-size: 26rpx;
    color: #666;
    margin-top: 5rpx;
}

.product-price {
    font-size: 28rpx;
    color: red;
    font-weight: bold;
    margin-left: auto;
}
/* 订单信息 */
.order-details {
    margin-top: 20rpx;
}

.detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.detail-label {
    font-size: 28rpx;
    color: #666;
}

.detail-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

/* 金额明细 */
.amount-details {
    margin-top: 20rpx;
}

.amount-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.amount-item.total {
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
    padding-bottom: 16rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.amount-label {
    font-size: 28rpx;
    color: #666;
}

.amount-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.total-amount {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
}
/* 底部操作栏 */
.action-bar {
    background-color: #fff;
    border-top: 1rpx solid #eee;
    padding: 20rpx 30rpx;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.action-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 20rpx;
}

.action-btn {
    padding: 20rpx 40rpx;
    border-radius: 50rpx;
    font-size: 28rpx;
    font-weight: 500;
    border: 2rpx solid #ff6b35;
}

.action-btn.primary {
    background-color: #ff6b35;
    color: white;
}

.action-btn.secondary {
    background-color: white;
    color: #ff6b35;
}
