}

.checkout-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
}

.checkout-summary-row:last-child {
    margin-bottom: 0;
}

.checkout-summary-row.total {
    padding-top: 16rpx;
    border-top: 1rpx solid #e0e0e0;
}

.checkout-summary-row.total .summary-label {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.checkout-summary-row.total .summary-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
}

.total-amount {
    font-size: 32rpx;
    font-weight: bold;
}

/* 结算底部栏 */
.checkout-footer {
    position: sticky;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
    z-index: 100;
}

.checkout-total-section {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.total-label {
    font-size: 28rpx;
    color: #666;
}

.total-price-large {
    font-size: 36rpx;
    font-weight: bold;
    color: #ff4757;
}

/* 提交订单按钮 */
.submit-order-btn {
    background: #ff6b35;
    color: white;
    border: none;
    border-radius: 50rpx;
    padding: 24rpx 48rpx;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
    text-align: center;
    cursor: pointer;
    user-select: none;
    min-width: 200rpx;
    margin: 0;
    line-height: normal;
    -webkit-tap-highlight-color: transparent;
}

.submit-order-btn.disabled {
    background: #cccccc;
    color: #999999;
    box-shadow: none;
}

.submit-order-btn:active {
    transform: scale(0.98);
    box-shadow: 0 2rpx 6rpx rgba(255, 107, 53, 0.3);
}

.submit-order-btn.disabled:active {
    transform: none;
    box-shadow: none;
}