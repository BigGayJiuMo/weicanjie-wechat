/* 页面整体容器 */
.container {
    padding: 0;
    background: #ffffff;
    min-height: 100vh;
  }
  
  /* 导航栏样式 */
  .navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 95rpx;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .nav-left,
  .nav-right {
    width: 80rpx;
    text-align: center;
  }
  
  .nav-center {
    flex: 1;
    text-align: center;
  }
  
  .back-icon {
    width: 48rpx;
    height: 48rpx;
  }
  
  .nav-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  /* 中间滚动区域：铺满导航栏和底部购物车之间 */
  .page-scroll {
    height: calc(100vh - 100rpx); /* navbar + 状态栏 */
    overflow: hidden;
    position: fixed;
    top: 175rpx;
    bottom: 120rpx;
    left: 0;
    right: 0;
    /* background: #000000; */
  }
  
  /* 餐厅信息卡片 */
  .restaurant-info-card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin: 0 20rpx 20rpx;
  }
  
  .restaurant-header {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
  }
  
  .restaurant-logo {
    width: 180rpx;
    height: 180rpx;
    border-radius: 12rpx;
    margin-right: 24rpx;
    object-fit: cover;
  }
  
  .restaurant-basic {
    flex: 1;
  }
  
/* 餐厅名称和收藏按钮在一行 */
.restaurant-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12rpx;
  }
  
  /* 餐厅名称 */
  .restaurant-name {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    max-width: 80%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  
  /* 收藏按钮 */
  .favorite-icon {
    width: 48rpx;
    height: 48rpx;
  }
  /* 餐厅营业状态样式 */
  .restaurant-status {
    display: inline-block;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    font-weight: bold;
  }
  
  .status-open {
    background: #e8f5e8;
    color: #07c160;
  }
  
  .status-closed {
    background: #fef0f0;
    color: #ff4757;
  }
  
  .status-break {
    background: #fff7e6;
    color: #ff8c00;
  }
  
  /* 餐厅元信息（评分、月售等） */
  .restaurant-meta {
    display: flex;
    justify-content: space-around;
    margin-bottom: 24rpx;
    padding: 20rpx 0;
  }
  
  .meta-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .meta-label {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 8rpx;
  }
  
  .meta-value {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  /* 餐厅描述 */
  .restaurant-desc {
    margin-bottom: 20rpx;
  }
  
  .desc-text {
    font-size: 26rpx;
    color: #666;
    line-height: 1.5;
  }
  
  .address-text {
    font-size: 24rpx;
    color: #666;
  }
  
  /* 吸顶 Tab */
  .main-tabs {
    display: flex;
    background: #fff;
    border-bottom: 1rpx solid #eee;
    padding: 20rpx 0;
    position: sticky;
    top: 0;
    z-index: 999; 
  }
  .tab-item {
    flex: 1;
    text-align: center;
    font-size: 30rpx;
    padding-bottom: 20rpx;
    color: #666;
  }
  
  .tab-item.active {
    color: #ff6b35;
    font-weight: bold;
    border-bottom: 4rpx solid #ff6b35;
  }
  .menu-wrapper{
  }
  /* 菜单内容区域（分类导航 + 菜品列表） */
  .menu-content {
    display: flex;
  flex-direction: row;
      /* background-color: violet; */
  }

  .sidebar-sticky {
    position: sticky;
    top: 100rpx;   
    align-self: flex-start;
}

  .category-sidebar {
    width: 160rpx;
    height: calc(98vh - 250rpx - 120rpx);
    max-height: calc(100vh - 260rpx - 120rpx);
    overflow-y: scroll;
    background: #f8f9fa;
    border-right: 1rpx solid #eee;
}

  .category-tab {
    padding: 30rpx 20rpx;
    font-size: 28rpx;
    text-align: center;
    border-bottom: 1rpx solid #e9ecef;
    transition: all 0.3s ease;
    position: relative;
    background: #f8f9fa;
    color: #333;
  }
  
  .category-tab.active {
    background: white;
    color: #ff6b35;
    font-weight: 600;
    border-left: 6rpx solid #ff6b35;
    box-shadow: inset 0 0 0 1px rgba(255, 107, 53, 0.1);
  }
  
  .tab-text {
    font-size: 28rpx;
    line-height: 1.4;
    display: block;
    font-weight: 500;
  }
  
  /* 右侧菜品内容区域 */
  .dishes-content {
    flex: 1;
  }
  
  /* 菜品分类标题 */
  .category-section {
    margin-bottom: 40rpx;
  }
  
  .section-header {
    padding: 30rpx 30rpx 20rpx;
    background: #ffffff;
  }
  
  .section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    display: block;
  }
  
  /* 菜品列表 */
  .dishes-list {
    display: flex;
    flex-direction: column;
  }
  
  /* 菜品卡片 */
  .dish-card {
    display: flex;
    padding: 30rpx;
    transition: all 0.3s ease;
    padding-bottom: 50rpx;
    background: #ffffff;
  }
  
  .dish-card:active {
    background: #f8f9fa;
  }
  
  .dish-image {
    width: 140rpx;
    height: 140rpx;
    border-radius: 16rpx;
    margin-right: 30rpx;
    flex-shrink: 0;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    background-color: #f0f0f0;
    object-fit: cover;
  }
  
  .dish-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  /* 菜名单独一行 */
  .dish-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 8rpx;
  }
  
  .dish-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    line-height: 1.4;
    flex-grow: 1;
    margin-right: 10rpx;
  }
  
  .dish-description {
    font-size: 26rpx;
    color: #666;
    line-height: 1.5;
    margin-bottom: 16rpx;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* 菜品控制栏 */
  .dish-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .dish-price {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
    flex-shrink: 0;
    margin-top: 10rpx;
    margin-bottom: 10rpx;
  }
  
  .controls-right {
    display: flex;
    align-items: center;
    gap: 10rpx;
  }
  
  .stock-info {
    font-size: 22rpx;
    color: #ff6b35;
    font-weight: 500;
    white-space: nowrap;
  }
  
  .sold-out {
    font-size: 22rpx;
    color: #999;
    font-weight: 500;
    white-space: nowrap;
  }
  
  /* 数量控制器 */
  .quantity-control {
    display: flex;
    align-items: center;
    gap: 10rpx;
  }
  
  .quantity-btn {
    width: 40rpx;
    height: 40rpx;
    line-height: 36rpx;
    text-align: center;
    border-radius: 50%;
    color: white;
    border: none;
    font-size: 36rpx;
    font-weight: bold;
    transition: all 0.3s ease;
    margin-top: 10rpx;
  }
  
  .quantity-btn.plus {
    background: #ff6b35;
    box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
  }
  
  .quantity-btn.minus {
    background: #f8f9fa;
    color: #666;
    border: 1rpx solid #e0e0e0;
  }
  
  .quantity-btn:active {
    transform: scale(0.95);
    box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
  }
  
  .quantity-text {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    min-width: 40rpx;
    text-align: center;
    line-height: 10rpx;
  }
  
  /* 购物车底部栏 */
  .cart-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
    z-index: 1500;
  }
  
  .cart-info {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .cart-icon-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .cart-icon {
    width: 60rpx;
    height: 60rpx;
  }
  
  .total-quantity {
    position: absolute;
    top: -8rpx;
    right: -8rpx;
    background: #ff6b35;
    color: white;
    font-size: 20rpx;
    font-weight: bold;
    padding: 8rpx;
    border-radius: 50%;
    min-width: 24rpx;
    height: 24rpx;
    text-align: center;
    line-height: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .price-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .price-row {
    display: flex;
    align-items: center;
  }
  
  .total-price {
    font-size: 36rpx;
    font-weight: bold;
    color: #ff4757;
  }
  
  .no-items {
    font-size: 28rpx;
    color: #999;
  }
  
  .checkout-btn {
    width: 200rpx;
    background: #ff6b35;
    color: white;
    border: none;
    border-radius: 50rpx;
    padding: 24rpx 40rpx;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
    text-align: center;
  }
  
  .checkout-btn.disabled {
    background: #cccccc;
    color: #999999;
    box-shadow: none;
  }
  
  /* 加载状态 */
  .loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100rpx 0;
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #999;
  }
  
  /* 购物车面板样式 */
  .order-panel-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 120rpx; /* 底部空出购物车栏 */
    background: rgba(0, 0, 0, 0);
    z-index: 1000;
    visibility: hidden;
    transition: all 0.3s ease;
    pointer-events: none;
  }
  
  .order-panel-mask.active {
    background: rgba(0, 0, 0, 0.5);
    visibility: visible;
    pointer-events: auto;
  }
  
  .order-panel {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 120rpx;
    background: white;
    border-radius: 24rpx 24rpx 0 0;
    z-index: 2000;
    transition: all 0.3s ease;
    height: 60vh;
    max-height: 60vh;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
  }
  
  .order-panel.active {
    transform: translateY(0);
  }
  
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .panel-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .clear-cart {
    padding: 12rpx 24rpx;
    background: #f8f9fa;
    border-radius: 20rpx;
  }
  
  .clear-text {
    font-size: 26rpx;
    color: #666;
  }
  
  .order-items-scroll {
    flex: 1;
    max-height: 700rpx;
  }
  
  .order-items-list {
    padding: 20rpx 30rpx;
  }
  
  .order-dish-card {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .order-dish-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .order-dish-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .order-dish-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
  }
  
  .order-dish-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
    margin-right: 20rpx;
  }
  
  .order-dish-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
    flex-shrink: 0;
  }
  
  .order-dish-controls {
    display: flex;
    justify-content: flex-end;
  }
  
  .item-total-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
    margin-right: auto;
  }
  
  .order-quantity-control {
    display: flex;
    align-items: center;
    gap: 16rpx;
    justify-content: flex-end;
  }
  
  .order-quantity-btn {
    width: 48rpx;
    height: 48rpx;
    line-height: 44rpx;
    text-align: center;
    border-radius: 50%;
    color: white;
    border: none;
    font-size: 32rpx;
    font-weight: bold;
    background: #ff6b35;
    box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
  }
  
  .order-quantity-btn.minus {
    background: #f8f9fa;
    color: #666;
    border: 1rpx solid #e0e0e0;
    box-shadow: none;
  }
  
  .order-quantity-btn.disabled {
    background: #cccccc;
    color: #999999;
    box-shadow: none;
  }
  
  .order-quantity-text {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    min-width: 40rpx;
    text-align: center;
  }
  
  /* 购物车订单汇总 */
  .order-summary {
    padding: 30rpx;
    border-top: 1rpx solid #f0f0f0;
  }
  
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .summary-row.total {
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
  }
  
  .summary-label {
    font-size: 28rpx;
    color: #666;
  }
  
  .summary-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
  }
  
  .summary-row.total .summary-label {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .summary-row.total .summary-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #ff4757;
  }
  
  /* 结算面板样式 */
  .checkout-panel-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0);
    z-index: 2500;
    visibility: hidden;
    pointer-events: none;
  }
  
  .checkout-panel-mask.active {
    background: rgba(0, 0, 0, 0.5);
    visibility: visible;
    pointer-events: auto;
  }
  
  .checkout-panel {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: white;
    border-radius: 24rpx 24rpx 0 0;
    z-index: 2600;
    transition: all 0.2s ease;
    height: 90vh;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    opacity: 0;
  }
  
  .checkout-panel.active {
    opacity: 1;
  }
  
  /* 结算面板头部 */
  .back-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 10vh;
    max-height: 10vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    z-index: 2700;
  }
  
  .back-icon1 {
    width: 36rpx;
    height: 36rpx;
  }
  
  .checkout-tips {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 30rpx;
    padding: 16rpx 24rpx;
    margin: 0 20rpx;
    margin-right: 20%;
  }
  
  .tips-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 12rpx;
  }
  
  .tips-text {
    font-size: 24rpx;
    color: #ffffff;
    font-weight: 500;
  }
  
  .checkout-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
    background: white;
    border-radius: 24rpx 24rpx 0 0;
    margin-top: 30rpx
  }
  
  .checkout-restaurant-info {
    display: flex;
    align-items: center;
    flex: 1;
  }
  
  .checkout-restaurant-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .checkout-restaurant-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
  }
  
  .checkout-restaurant-status {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 12rpx;
  }
  
  /* 结算内容区域 */
  .checkout-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 20rpx;
  }
  
  .checkout-items-section {
    flex: 1;
    padding: 20rpx 30rpx;
  }
  
  .checkout-items-list {
    max-height: 700rpx;
    overflow-y: auto;
  }
  
  .checkout-dish-item {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .checkout-dish-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .checkout-dish-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .checkout-dish-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
  }
  
  .checkout-dish-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
    margin-right: 20rpx;
  }
  
  .checkout-dish-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
    flex-shrink: 0;
  }
  
  .checkout-dish-quantity {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8rpx;
  }
  
  .quantity-label {
    font-size: 26rpx;
    color: #666;
  }
  
  .quantity-value {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  .eat-type-row {
    display: flex;
    align-items: center;
  }
  
  .eat-label {
    font-size: 28rpx;
    color: #555;
    margin-right: 20rpx;
  }
  
  .eat-select {
    display: flex;
    gap: 20rpx;
  }
  
  .eat-btn {
    padding: 10rpx 26rpx;
    border-radius: 30rpx;
    border: 1px solid #ccc;
    font-size: 26rpx;
    color: #666;
  }
  
  .eat-btn.active {
    background: #ff6b35;
    border-color: #ff6b35;
    color: #fff;
  }
  
/* 备注行：标题 + 内容一行显示 */
.remark-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  /* 右侧内容：备注 + 按钮 */
  .remark-right {
    display: flex;
    align-items: center;
    gap: 20rpx;
    max-width: 60%;
    justify-content: flex-end;
  }
  
  /* 备注显示区域（自动截断） */
  .remark-text {
    max-width: 300rpx;
    font-size: 28rpx;
    color: #333;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  
  /* 修改按钮 */
  .edit-remark-btn {
    padding: 6rpx 20rpx;
    background: #ff6b35;
    color: #fff;
    border-radius: 10rpx;
