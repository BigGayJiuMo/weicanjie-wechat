<view class="container">

<!-- 顶部导航栏（固定） -->
<view class="navbar">
  <view class="navbar-content">
    <view class="nav-left">
      <image class="back-icon" src="/images/back.png" bindtap="onBack"></image>
    </view>
    <view class="nav-center">
      <text class="nav-title">餐厅详情</text>
    </view>
    <view class="nav-right"></view>
  </view>
</view>

<!-- 中间区域整页滚动：餐厅信息 + tabs + 菜品/评价/商家 -->
<scroll-view
id="pageScroll"
  class="page-scroll"
  scroll-y="true"
  enhanced="true"
  use-enhanced="true"
  scroll-with-animation="true"
  bindscroll="onPageScroll"
>
    <!-- 餐厅停业提示 -->
    <view class="closed-tip-container" wx:if="{{isClosed}}">
    <view class="closed-tip-box">
        <image class="closed-icon" src="/images/logo.png"></image>
        <text class="closed-title">商家已下架</text>
        <text class="closed-subtitle">请选择其他商家</text>
        <view class="closed-btns">
        <view class="back-home-btn" bindtap="onBack">
            返回
        </view>
        </view>
    </view>
    </view>
    <view wx:if="{{!isClosed}}">
  <!-- 餐厅基本信息 -->
  <view class="restaurant-info-card" wx:if="{{restaurant}}">
    <view class="restaurant-header">
        <image class="restaurant-logo" src="{{restaurant.logoUrl}}"></image>

        <view class="restaurant-basic">

            <!-- 餐厅名称 + 收藏 -->
            <view class="restaurant-name-row">
            <text class="restaurant-name">{{restaurant.name}}</text>

            <image
                class="favorite-icon"
                src="{{isFavorite ? '/images/fav-on.png' : '/images/fav-off.png'}}"
                bindtap="toggleFavorite"
            ></image>
            </view>

            <!-- 营业状态 -->
            <view class="restaurant-status {{statusClass}}">
            {{statusText}}
            </view>

        </view>
    </view>

    <!-- 信息 -->
    <view class="restaurant-meta">
        <view class="meta-item" wx:if="{{restaurant.avgRating !== null}}">
            <text class="meta-label">评分</text>
            <text class="meta-value">{{restaurant.avgRating}}</text>
        </view>

        <view class="meta-item">
            <text class="meta-label">月售</text>
            <text class="meta-value">{{restaurant.monthlySales}}</text>
        </view>

        <view class="meta-item">
            <text class="meta-label">打包</text>
            <text class="meta-value">¥{{restaurant.packingFeeText}}</text>
        </view>
    </view>

    <view class="eat-type-row">
        <text class="eat-label">用餐方式：</text>

        <view class="eat-select">
            <view class="eat-btn {{eatType == 1 ? 'active' : ''}}" data-type="1" bindtap="selectEatType">
            堂食
            </view>
            <view class="eat-btn {{eatType == 2 ? 'active' : ''}}" data-type="2" bindtap="selectEatType">
            外带
            </view>
        </view>
    </view>
  </view>

  <!-- 横向吸顶 Tab（点餐 / 评价 / 商家）-->
  <view class="main-tabs {{hideTabs ? 'hidden' : ''}}">
    <view
      class="tab-item {{activeTab === 'menu' ? 'active' : ''}}"
      data-tab="menu"
      bindtap="switchTab"
    >点餐</view>
    <view
      class="tab-item {{activeTab === 'rating' ? 'active' : ''}}"
      data-tab="rating"
      bindtap="switchTab"
    >评价</view>
    <view
      class="tab-item {{activeTab === 'shop' ? 'active' : ''}}"
      data-tab="shop"
      bindtap="switchTab"
    >商家</view>
  </view>

  <!-- 点 餐 区 域 -->
  <view wx:if="{{activeTab === 'menu'}}" class="menu-wrapper">

<view class="menu-content">

  <!-- 左侧分类（sticky 吸顶） -->
  <view class="sidebar-sticky">
          <view class="category-sidebar">
            <view
                wx:for="{{categories}}"
                wx:key="id"
                class="category-tab {{activeCategoryId === item.id ? 'active' : ''}}"
                bindtap="onCategoryTap"
                data-id="{{item.id}}"
                >
                {{item.name}}
            </view>
          </view>
      </view>

  <!-- 右侧菜品区域（页面滚动即可，无 scroll-view） -->
  <view class="dishes-content">

    <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-section"
        id="cat-{{item.id}}"
    >

      <view class="section-header">
        <text class="section-title">{{item.name}}</text>
      </view>

      <view class="dishes-list">

        <view wx:for="{{item.dishes}}" wx:key="id" class="dish-card" bindtap="goDishDetail" data-id="{{item.id}}">
          <image class="dish-image" src="{{item.imageUrl}}"></image>

          <view class="dish-details">

            <view class="dish-header">
              <text class="dish-name">{{item.name}}</text>
            </view>

            <text class="dish-description">{{item.description}}</text>

            <view class="dish-controls">
                <text class="dish-price">¥{{item.formattedPrice}}</text>

                <view class="controls-right">
                    <view class="quantity-control">

                    <!-- 减 -->
                    <view
                        class="quantity-btn minus"
                        wx:if="{{cartItems[item.id] > 0}}"
                        catchtap="onDecreaseQuantity"
                        data-dish="{{item}}"
                    >-</view>

                    <text wx:if="{{cartItems[item.id] > 0}}" class="quantity-text">
                        {{cartItems[item.id]}}
                    </text>

                    <!-- 加 -->
                    <view
                        class="quantity-btn plus"
                        catchtap="onIncreaseQuantity"
                        data-dish="{{item}}"
                    >+</view>

                    </view>
                </view>
                </view>

          </view>

        </view>

      </view>

    </view>

  </view>

</view>

</view> 

  <!-- 评价页面 -->
<view wx:if="{{activeTab === 'rating'}}" class="rating-page">

<!-- 商家评分区域，只有在有评价时才显示 -->
<view wx:if="{{ratingList.length > 0}}" class="rating-summary-box">

  <!-- 左侧大评分数字 + 星星 -->
    <view class="rating-summary-left">
    <text class="rating-summary-score">评分 {{avgShopRating}}</text>

    <!-- 星星 -->
    <view class="star-row">
        <block wx:for="{{5}}" wx:key="*this">
        <image
            class="star"
            src="{{ index < avgShopRatingInt ? '/images/star-on.png' : '/images/star-off.png' }}"
        />
        </block>
    </view>
    </view>

  <!-- 右侧味道 + 包装（靠右） -->
  <view class="rating-summary-sub">
    <view class="sub-item">
      <text class="sub-label">味道</text>
      <text class="sub-value">{{avgTaste}}</text>
    </view>

    <view class="sub-item">
      <text class="sub-label">包装</text>
      <text class="sub-value">{{avgPack}}</text>
    </view>
  </view>

</view>

<!-- 如果没有评价，显示提示 -->
<view wx:else class="no-rating-message">
  <text>当前没有评价</text>
</view>

<!-- 排序按钮 -->
<view class="rating-filter-bar" wx:if="{{ratingList.length > 0}}">
  <view class="filter-btn {{isLatest ? 'active' : ''}}" bindtap="toggleLatest">
    最新
  </view>
  <view  class="filter-btn {{hasImageFilter ? 'active' : ''}}"  bindtap="toggleHasImage" style="margin-left:20rpx;">
    有图
  </view>
</view>

<!-- 评价列表 -->
<view class="rating-list">
  <view class="rating-item" wx:for="{{ratingList}}" wx:key="id">

    <view class="user-info">
      <image class="avatar" src="{{item.avatar}}"></image>
      <view class="user-meta">
        <text class="username">{{item.username}}</text>
      </view>
      <view class="report-btn" bindtap="onReport" data-id="{{item.id}}">
        举报
      </view>
    </view>

    <!-- 满意度 + 标签区域 -->
    <view class="rate-detail-tags-row">
      <text class="tag-text">满意度 {{item.satisfaction || 5}}星</text>
      <text class="tag-text">味道 {{item.taste || 5}}星</text>
      <text class="tag-text">包装 {{item.pack || 5}}星</text>
    </view>

    <view class="rate-text">{{item.content}}</view>

    <view class="rate-images" wx:if="{{item.images && item.images.length}}">
      <image wx:for="{{item.images}}" wx:key="i" class="rate-img"
        src="{{item}}"
        data-urls="{{item.images}}"
        data-url="{{item}}"
        bindtap="previewImage"
        mode="aspectFill"></image>
    </view>
    <text class="rate-time-bottom">{{item.time}}</text>
    <!-- 商家回复 -->
    <view class="reply-box" wx:if="{{item.replyContent}}">
        <view class="reply-header">
            <text class="reply-title">商家回复：</text>
        </view>
        <view class="reply-content-box">
            <text class="reply-content">{{item.replyContent}}</text>
        </view>
        <text class="reply-time">{{item.replyTime}}</text>
    </view>
    </view>
</view>

</view>

  <!-- 商 家 区 域 -->
  
  <view wx:if="{{activeTab === 'shop'}}" class="shop-page">

<!-- 商家信息卡片 -->
<view class="shop-card">

  <view class="shop-header">
    <text class="shop-name">{{restaurant.name}}</text>
  </view>

  <view class="shop-row">
    <image class="shop-icon" src="/images/location.png"></image>
    <text class="shop-text">{{restaurant.address}}</text>
  </view>

  <view class="shop-row" bindtap="showBusinessHoursDialog">
    <image class="shop-icon" src="/images/clock.png"></image>
    <text class="shop-text">查看营业时间表</text>
  </view>
  <view class="shop-row" bindtap="onCallShop">
    <image class="shop-icon" src="/images/phone.png"></image>
    <text class="shop-text">{{restaurant.contactPhone}}</text>
  </view>
  <view class="shop-photos-row">
    <image
    wx:for="{{restaurant.shopImages}}"
    wx:key="i"
    class="shop-photo"
    src="{{item}}"
    mode="aspectFill"
    data-url="{{item}}"
    data-urls="{{restaurant.shopImages}}"
    bindtap="previewShopImage"
  ></image>
</view>

</view>

<!-- 商家承诺 -->
<view class="shop-card">
  <text class="shop-subtitle">商家承诺</text>

  <view class="shop-promises">
    <view class="shop-promise">
      <text class="promise-icon">✔</text> 食品安全
    </view>
    <view class="shop-promise">
      <text class="promise-icon">✔</text> 亮证经营
    </view>
    <view class="shop-promise">
      <text class="promise-icon">✔</text> 食无忧保障
    </view>
  </view>
</view>

</view>
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 给底部一点空隙，避免被购物车栏压住 -->
  <view style="height: 150rpx;"></view>
</view>
</scroll-view>

<!-- 购物车底部栏：固定在底部 -->
<view class="cart-bar" bindtap="onCartBarTap" wx:if="{{!isClosed}}">
  <view class="cart-info">
    <view class="cart-icon-container">
      <image class="cart-icon" src="/images/cart.png"></image>
      <text class="total-quantity" wx:if="{{totalQuantity > 0}}">{{totalQuantity}}</text>
    </view>
    <view class="price-info">
      <view class="price-row">
        <text class="total-price" wx:if="{{totalQuantity > 0}}">¥{{formattedTotalPrice}}</text>
        <text class="no-items" wx:else>未选择商品</text>
      </view>
    </view>
  </view>
  <view class="checkout-btn {{ (!canOrder || totalQuantity === 0) ? 'disabled' : '' }}" catchtap="onCheckout">
  {{ !canOrder ? '商家未营业' : (totalQuantity === 0 ? '请选择商品' : '去结算') }}
</view>
</view>

<!-- 🛒 购物车详情面板 -->
<view class="order-panel-mask {{showOrderPanel ? 'active' : ''}}" catchtap="hideOrderPanel">
  <view class="order-panel {{showOrderPanel ? 'active' : ''}}" catchtap="stopPropagation">

    <view class="panel-header">
      <text class="panel-title">已选商品</text>

      <view class="clear-cart" bindtap="clearCart" wx:if="{{totalQuantity > 0}}">
        <text class="clear-text">清空</text>
      </view>
    </view>

    <scroll-view class="order-items-scroll" scroll-y="true">
      <view class="order-items-list">
        <view class="order-dish-card" wx:for="{{orderItems}}" wx:key="id">
          <image class="order-dish-image" src="{{item.imageUrl}}"></image>

          <view class="order-dish-details">
            <view class="order-dish-header">
              <text class="order-dish-name">{{item.name}}</text>
              <text class="order-dish-price">¥{{item.subtotal}}</text>
            </view>

            <view class="order-dish-controls">

              <view class="order-quantity-control">
                <view
                  class="order-quantity-btn minus"
                  bindtap="onOrderDecreaseQuantity"
                  data-dish="{{item}}"
                >-</view>

                <text class="order-quantity-text">{{item.quantity}}</text>

                <view
                  class="order-quantity-btn plus"
                  bindtap="onOrderIncreaseQuantity"
                  data-dish="{{item}}"
                  wx:if="{{item.stock > item.quantity}}"
                >+</view>
                <view class="order-quantity-btn plus disabled" wx:else>+</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="order-summary" wx:if="{{totalQuantity > 0}}">
      <view class="summary-row">
        <text class="summary-label">菜品小计</text>
        <text class="summary-value">¥{{formattedSubTotal}}</text>
      </view>

      <view class="summary-row" wx:if="{{showPackingFee}}">
        <text class="summary-label">打包费</text>
        <text class="summary-value">¥{{packingFee}}</text>
      </view>
    </view>

  </view>
</view>

<!-- 💳 结算面板 -->
<view class="checkout-panel-mask {{showCheckoutPanel ? 'active' : ''}}" catchtap="hideCheckoutPanel">

  <view class="back-header">
    <view class="checkout-back-btn" bindtap="hideCheckoutPanel">
      <image class="back-icon1" src="/images/back4.png"></image>
    </view>

    <view class="checkout-tips">
      <image class="tips-icon" src="/images/horn.png"></image>
      <text class="tips-text">温馨提示：请适量点餐、避免浪费</text>
    </view>
  </view>

  <view class="checkout-panel {{showCheckoutPanel ? 'active' : ''}}" catchtap="stopPropagation">

    <view class="checkout-header">
      <view class="checkout-restaurant-info">
        <view class="checkout-restaurant-details">
          <text class="checkout-restaurant-name">{{restaurant.name}}</text>
        </view>
      </view>
    </view>

    <view class="checkout-content">

      <view class="checkout-items-section">
        <view class="checkout-items-list">
          <view class="checkout-dish-item" wx:for="{{checkoutItems}}" wx:key="id">
            <image class="checkout-dish-image" src="{{item.imageUrl}}"></image>

            <view class="checkout-dish-info">
              <view class="checkout-dish-main">
                <text class="checkout-dish-name">{{item.name}}</text>
                <text class="checkout-dish-price">¥{{item.subtotal}}</text>
              </view>

              <view class="checkout-dish-quantity">
                <text class="quantity-label">✖</text>
                <text class="quantity-value">{{item.quantity}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    <!-- 订单备注 -->
    <view class="checkout-summary">
    <view class="remark-row">
    <text class="summary-title">订单备注</text>
    <view class="remark-right">
        <view class="edit-remark-btn" bindtap="openRemarkDialog">
        修改
        </view>
        <text class="remark-text">{{remark || '无备注'}}</text>
    </view>
    </view>
    </view>
      <view class="checkout-summary">
        <view class="checkout-summary-title">
          <text class="summary-title">费用明细</text>
        </view>
        <view class="checkout-summary-row">
          <text class="summary-label">菜品小计</text>
          <text class="summary-value">¥{{formattedSubTotal}}</text>
        </view>
        <view class="checkout-summary-row" wx:if="{{showPackingFee}}">
          <text class="summary-label">打包费</text>
          <text class="summary-value">¥{{packingFee}}</text>
        </view>
      </view>
    </view>
    <view class="checkout-footer">
      <view class="checkout-total-section">
        <text class="total-label">总计:</text>
        <text class="total-price-large">¥{{formattedTotalPrice}}</text>
      </view>
      <view class="submit-order-btn {{totalQuantity === 0 ? 'disabled' : ''}}" bindtap="onSubmitOrder">
        提交订单
      </view>
    </view>

  </view>
</view>

</view>
<!-- 修改备注弹窗 -->
<view class="remark-dialog" wx:if="{{remarkDialogVisible}}">
    <view class="dialog-mask"></view>

    <view class="dialog-box">
        <view class="dialog-title">修改备注</view>

        <textarea
            class="dialog-input"
            placeholder="请输入备注"
            maxlength="200"
            value="{{remarkTemp}}"
            bindinput="onRemarkInputChange"
        ></textarea>

        <view class="dialog-actions">
            <button class="cancel-btn" bindtap="closeRemarkDialog">取消</button>
            <button class="confirm-btn" bindtap="submitRemark">确定</button>
        </view>
    </view>
</view>

<!-- 营业时间弹窗 -->
<view class="hours-dialog-mask" wx:if="{{hoursDialogVisible}}" catchtap="hideHoursDialog">
  <view class="hours-dialog" catchtap="stopPropagation">

    <view class="dialog-title">营业时间</view>

    <view class="hours-list">
      <view wx:for="{{businessHoursFormatted}}" wx:key="day" class="hours-item">
        <text class="day">{{item.day}}</text>
        <text class="time">{{item.time}}</text>
      </view>
    </view>

    <view class="dialog-footer">
      <button class="close-btn" bindtap="hideHoursDialog">关闭</button>
    </view>

  </view>
</view>