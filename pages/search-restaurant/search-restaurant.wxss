/* pages/search-restaurant/search-restaurant.wxss */
.container {
    padding-top: 160rpx;
    background: #f5f5f5;
    min-height: 100vh;
  }
  
  /* 导航栏 */
  .navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 95rpx;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .nav-left,
  .nav-right {
    width: 80rpx;
    text-align: center;
  }
  
  .nav-center {
    flex: 1;
    text-align: center;
  }
  
  .back-icon {
    width: 48rpx;
    height: 48rpx;
  }
  
  .nav-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  
  /* 搜索栏 */
  .search-bar {
    margin-top: 30rpx;
    background: #fff;
    display: flex;
    padding: 20rpx 30rpx;
    align-items: center;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  }
  .search-input {
    flex: 1;
    font-size: 30rpx;
  }
  .search-icon {
    width: 40rpx;
    height: 40rpx;
  }
  /* 实时联想框 */
.suggest-box {
    background: white;
    margin-top: 2rpx;
    border-radius: 12rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  }
  
  .suggest-item {
    padding: 24rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .suggest-item:last-child {
    border-bottom: none;
  }
  
  .suggest-item text {
    font-size: 28rpx;
    color: #333;
  }
  
  .suggest-item:active {
    background: #f5f5f5;
  }
  /* 搜索结果使用首页样式 */
  .result-scroll {
    height: calc(100vh - 200rpx);
  }
  
  .restaurant-list {
    padding: 20rpx;
  }
  
  .restaurant-item {
    background: white;
    border-radius: 20rpx;
    margin-bottom: 24rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  }
  
  .restaurant-body {
    display: flex;
    padding: 30rpx;
  }
  
  /* 修改：餐厅图片样式 - 放在左侧 */
  .restaurant-image {
    width: 250rpx;
    height: 250rpx;
    border-radius: 12rpx;
    margin-right: 24rpx;
    margin-top: 8rpx;
    flex-shrink: 0; /* 防止图片被压缩 */
  }
  
  /* 修改：餐厅内容区域 - 占据剩余空间 */
  .restaurant-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .restaurant-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20rpx;
  }
  
  .restaurant-name {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    flex: 1;
    margin-right: 20rpx;
  }
  
  .restaurant-status {
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    font-weight: bold;
    flex-shrink: 0; /* 防止状态标签被压缩 */
  }
  
  .status-open {
    background: #e8f5e8;
    color: #07c160;
  }
  
  .status-closed {
    background: #fef0f0;
    color: #ff4757;
  }
  
  .status-break {
    background: #fff7e6;
    color: #ff8c00;
  }
  
  .rating-row {
      display: flex;
      align-items: center;
      margin-bottom: 16rpx;
      gap: 16rpx;
    }
    .restaurant-rating {
      display: flex;
      align-items: center;
    }
    
    .rating-star {
      color: #ff6b35;
      font-size: 24rpx;
      margin-right: 8rpx;
    }
    
    .rating-score {
      font-size: 26rpx;
      color: #ff6b35;
      margin-right: 16rpx;
      font-weight: bold;
    }
    
    .rating-count {
      font-size: 24rpx;
      color: #666;
    }
  
  .restaurant-info {
    display: flex;
    gap: 20rpx;
    margin-bottom: 16rpx;
    flex-wrap: wrap; /* 允许在小屏幕上换行 */
  }
  
  .info-item {
    font-size: 24rpx;
    color: #666;
  }
  
  .restaurant-desc {
    margin-bottom: 20rpx;
    flex: 1; /* 描述区域占据可用空间 */
  }
  
  .desc-text {
    font-size: 26rpx;
    color: #666;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .restaurant-tags {
    display: flex;
    gap: 16rpx;
    flex-wrap: wrap; /* 允许标签换行 */
  }
  
  .tag {
    font-size: 22rpx;
    color: #ff6b35;
    background: #fff0e8;
    padding: 6rpx 12rpx;
    border-radius: 12rpx;
    border: 1rpx solid #ffd8c8;
  }
  
  /* 历史记录区域 */
.history-box {
    padding: 20rpx 30rpx;
    background: white;
    border-radius: 20rpx;
  }
  
  .history-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
    font-size: 25rpx;
  }
  
  .clear-btn {
    color: #ff4d4f;
    font-size: 26rpx;
  }
  
  .history-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx 30rpx;
  }
  
  .history-item {
    background: #f6f6f6;
    padding: 10rpx 24rpx;
    border-radius: 40rpx;
    display: flex;
    align-items: center;
    gap: 10rpx;
  }
  .history-text{
    font-size: 25rpx;
    line-height: 1rpx;
    margin-bottom: 15rpx;
  }
  
  .history-item text {
    font-size: 25rpx;
  }
  
  .delete-history {
    font-size: 26rpx;
    color: #999;
  }
  .empty-box {
    padding-top: 120rpx;
    text-align: center;
    color: #999;
  }
  
  .empty-img {
    width: 240rpx;
    height: 240rpx;
    opacity: 0.6;
    margin-bottom: 30rpx;
  }
  
  .empty-text {
    font-size: 30rpx;
    color: #888;
  }