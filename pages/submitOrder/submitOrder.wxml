<view class="container">

<!-- 顶部导航栏 -->
<view class="navbar">
  <view class="navbar-content">
    <view class="nav-left" bindtap="onBack">
      <image class="back-icon" src="/images/back.png"></image>
    </view>
    <view class="nav-center">
      <text class="nav-title">提交订单</text>
    </view>
    <view class="nav-right"></view>
  </view>
</view>

<!-- 中间：可滚动订单内容 -->
<scroll-view scroll-y="true" class="scroll-area">

  <!-- 多餐厅循环 -->
  <view class="restaurant-card" wx:for="{{orderList}}" wx:key="restaurantId">

    <!-- 餐厅标题 -->
    <view class="restaurant-header">
      <text class="restaurant-title">{{item.restaurantName}}</text>
    </view>

    <!-- 菜品列表 -->
    <view class="cart-items">
      <view class="cart-item" 
            wx:for="{{item.items}}" 
            wx:key="id" 
            wx:for-item="dish">

        <image class="item-image" 
               src="{{dish.dishImageUrl || dish.imageUrl || '/images/default-dish.png'}}" 
               mode="aspectFill"></image>

        <view class="item-details">

          <!-- 左：菜名 + 单价 -->
          <view class="item-header">
            <text class="item-name">{{dish.dishName || dish.name}}</text>
            <text class="item-total-price">¥{{dish.dishPrice || dish.price}}</text>
          </view>

          <!-- 右：数量 + 小计 -->
          <view class="item-controls">
            <view class="item-total-price">
              ¥{{dish.totalPrice}}
            </view>
            <view class="item-count" style="color: #666;">
              ×{{dish.quantity}}
            </view>
          </view>

        </view>

      </view>
    </view>

    <!-- 金额明细 -->
    <view class="amount-info">
      <view class="amount-line">
        <text>菜品小计</text>
        <text>¥{{item.dishSubTotal}}</text>
      </view>
      <view class="amount-line" wx:if="{{item.eatType == 2}}">
        <text>打包费</text>
        <text>¥{{item.packingFee}}</text>
      </view>
      <!-- 订单备注 -->
    <view class="amount-line">
        <text>订单备注</text>
        <view class="remark-right">
            <view 
                class="edit-remark-btn"
                bindtap="openRemarkDialog"
                data-restaurant-id="{{item.restaurantId}}"
            >
                修改
            </view>
        <text class="remark-text">{{item.remarkShort || '无备注'}}</text>
        </view>
    </view>
      <!-- 小计 -->
      <view class="total-line">
        <text>小计</text>
        <text class="total-num">¥{{item.subTotal}}</text>
      </view>
    </view>
    
  </view>

  <!-- 底部空白占位 -->
  <view style="height: 160rpx"></view>

</scroll-view>

<!-- 底部栏 -->
<view class="bottom-bar">
  <view class="bottom-left">
    <text class="total-amount">¥{{totalAmount}}</text>
    <text class="order-count">共 {{orderCount}} 单</text>
  </view>
  <view class="submit-btn" bindtap="submitOrder">
    提交订单
  </view>
</view>

</view>

<!-- 修改备注弹窗 -->
<view class="remark-dialog" wx:if="{{remarkDialogVisible}}">
    <view class="dialog-mask"></view>

    <view class="dialog-box">
        <view class="dialog-title">修改备注</view>

        <textarea
            class="dialog-input"
            placeholder="请输入备注"
            maxlength="200"
            value="{{remarkTemp}}"
            bindinput="onRemarkInputChange"
        ></textarea>

        <view class="dialog-actions">
            <button class="cancel-btn" bindtap="closeRemarkDialog">取消</button>
            <button class="confirm-btn" bindtap="submitRemark">确定</button>
        </view>
    </view>
</view>