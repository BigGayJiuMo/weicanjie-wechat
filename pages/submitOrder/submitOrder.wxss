/* 页面整体容器 */
.container {
    background: #f5f5f5;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

/* 顶部导航栏 */
.navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 90rpx;
    border-bottom: 1rpx solid #eee;
}

.navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-left, .nav-right {
    width: 80rpx;
}

.nav-center {
    flex: 1;
    text-align: center;
}

.back-icon {
    width: 48rpx;
    height: 48rpx;
}

.nav-title {
    font-size: 34rpx;
    font-weight: bold;
}

/* 滚动区域 */
.scroll-area {
    flex: 1;
    overflow-y: scroll;
}

/* 餐厅卡片 */
.restaurant-card {
    background: #fff;
    margin: 20rpx;
    padding: 24rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.restaurant-header {
    margin-bottom: 20rpx;
}

.restaurant-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

/* ===== 购物车同款菜品样式（唯一实际使用） ===== */

.cart-items {
    padding: 0 10rpx;
}

.cart-item {
    display: flex;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
}

.cart-item:last-child {
    border-bottom: none;
}

.item-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
}

.item-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
}

.item-count {
    font-size: 26rpx;
    color: #666;
}

.item-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.item-total-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
}

/* 金额明细 */
.amount-info {
    margin-top: 20rpx;
}

.amount-line {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10rpx;
    font-size: 26rpx;
    color: #666;
}

.discount {
    color: #ff4d4f;
}

.total-line {
    display: flex;
    justify-content: space-between;
    border-top: 1rpx solid #eee;
    padding-top: 20rpx;
    margin-top: 20rpx;
    font-size: 30rpx;
    font-weight: bold;
}

.total-num {
    color: #ff4d4f;
}

/* 底部提交栏 */
.bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120rpx;
    background: white;
    border-top: 1rpx solid #ddd;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30rpx;
}

.bottom-left {
    display: flex;
    flex-direction: column;
}

.order-count {
    font-size: 24rpx;
    color: #666;
}

.total-amount {
    font-size: 36rpx;
    font-weight: bold;
    color: #ff4d4f;
}

/* 按钮 */
.submit-btn {
    background: #ff6b35;
    padding: 20rpx 60rpx;
    color: white;
    font-size: 32rpx;
    font-weight: bold;
    border-radius: 50rpx;
}
