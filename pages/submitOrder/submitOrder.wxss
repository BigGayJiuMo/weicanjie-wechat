/* 页面整体容器 */
.container {
    background: #f5f5f5;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

/* 顶部导航栏 */
.navbar {
    background: white;
    padding: 20rpx 30rpx;
    padding-top: 90rpx;
    border-bottom: 1rpx solid #eee;
}

.navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-left, .nav-right {
    width: 80rpx;
}

.nav-center {
    flex: 1;
    text-align: center;
}

.back-icon {
    width: 48rpx;
    height: 48rpx;
}

.nav-title {
    font-size: 34rpx;
    font-weight: bold;
}

/* 滚动区域 */
.scroll-area {
    flex: 1;
    overflow-y: scroll;
}

/* 餐厅卡片 */
.restaurant-card {
    background: #fff;
    margin: 20rpx;
    padding: 24rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.restaurant-header {
    margin-bottom: 20rpx;
}

.restaurant-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

/* ===== 购物车同款菜品样式（唯一实际使用） ===== */

.cart-items {
    padding: 0 10rpx;
}

.cart-item {
    display: flex;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
}

.cart-item:last-child {
    border-bottom: none;
}

.item-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16rpx;
}

.item-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
}

.item-count {
    font-size: 26rpx;
    color: #666;
}

.item-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.item-total-price {
    font-size: 28rpx;
    font-weight: bold;
    color: #ff4757;
}

/* 金额明细 */
.amount-info {
    margin-top: 20rpx;
}

.amount-line {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10rpx;
    font-size: 26rpx;
    color: #666;
}

.discount {
    color: #ff4d4f;
}

.total-line {
    display: flex;
    justify-content: space-between;
    border-top: 1rpx solid #eee;
    padding-top: 20rpx;
    margin-top: 20rpx;
    font-size: 30rpx;
    font-weight: bold;
}

.total-num {
    color: #ff4d4f;
}
/* 备注行布局 */
.remark-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

/* 右侧区域：按钮 + 文本，整体靠右 */
.remark-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20rpx;
}

/* 备注文本（最多10字 + 自动截断样式） */
.remark-text {
    margin-top: 5rpx;
    max-width: 300rpx;  /* 控制文本宽度，让…正常出现 */
    font-size: 28rpx;
    color: #333;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.edit-remark-btn {
    margin-top: 10rpx;
    margin-left: 20rpx;
    padding: 4rpx 12rpx;
    font-size: 24rpx;
    background: #ff6b35;
    color: rgb(255, 255, 255);
    border-radius: 6rpx;
  }
/* 底部提交栏 */
.bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120rpx;
    background: white;
    border-top: 1rpx solid #ddd;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30rpx;
}

.bottom-left {
    display: flex;
    flex-direction: column;
}

.order-count {
    font-size: 24rpx;
    color: #666;
}

.total-amount {
    font-size: 36rpx;
    font-weight: bold;
    color: #ff4d4f;
}

/* 按钮 */
.submit-btn {
    background: #ff6b35;
    padding: 20rpx 60rpx;
    color: white;
    font-size: 32rpx;
    font-weight: bold;
    border-radius: 50rpx;
}
.remark-dialog .dialog-mask {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    z-index: 999;
  }
  
  .dialog-box {
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    background: #fff;
    border-radius: 12rpx;
    padding: 30rpx;
    z-index: 1000;
  }
  
  .dialog-title {
    font-size: 32rpx;
    font-weight: bolder;
    margin-bottom: 20rpx;
  }
  
  .dialog-input {
    width: 100%;
    min-height: 150rpx;
    background: #f7f7f7;
    border-radius: 10rpx;
    padding: 16rpx;
  }
  
  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 20rpx;
  }
  
  .cancel-btn, .confirm-btn {
    margin-left: 20rpx;
    padding: 10rpx 20rpx;
    border-radius: 8rpx;
  }
  
  .confirm-btn {
    background: #ff6b35;
    color: white;
  }